{
    "manufacturer": "lckfb",
    "type": "lichuang-dev",
    "target": "esp32s3",
    "builds": [
        {
            "name": "lichuang-dev",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y"
            ]
        },
        {
            "name": "lichuang-dev-metaos",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_METAOS_ENABLE=y",
                "CONFIG_FATFS_LFN_HEAP=y",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_BLUEDROID_ENABLED=y",
                "CONFIG_BT_CONTROLLER_ENABLED=y",
                "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_metaos.csv\""
            ]
        },
        {
            "name": "lichuang-dev-metaos-wechat",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_METAOS_ENABLE=y",
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=y",
                "CONFIG_FATFS_LFN_HEAP=y",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_BLUEDROID_ENABLED=y",
                "CONFIG_BT_CONTROLLER_ENABLED=y",
                "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_metaos.csv\""
            ]
        },
        {
            "name": "lichuang-dev-rescue",
            "sdkconfig_append": [
                "CONFIG_METAOS_RESCUE_MODE=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_metaos.csv\"",
                "CONFIG_FLASH_NONE_ASSETS=y",
                "CONFIG_BT_ENABLED=n",
                "CONFIG_USE_AUDIO_PROCESSOR=n",
                "CONFIG_USE_DEVICE_AEC=n",
                "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n",
                "CONFIG_WAKE_WORD_DISABLED=y",
                "CONFIG_FATFS_LFN_HEAP=y",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_LV_USE_TABVIEW=y",
                "CONFIG_LV_USE_BTNMATRIX=y",
                "CONFIG_LV_USE_LIST=y",
                "CONFIG_LV_USE_MSGBOX=y"
            ]
        }
    ]
}
